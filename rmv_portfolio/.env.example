# Copy to .env.local and fill in. All values are examples, not real secrets.

# ── Email (contact form + notifications) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your_app_password
CONTACT_EMAIL=you@example.com
# Optional: send an auto-reply to people who use the contact form
SEND_AUTO_REPLY=false

# ── Database (portfolio rating system, Prisma Accelerate) ───────────────
PRISMA_DATABASE_URL=prisma://accelerate.prisma-data.net/?api_key=your_key
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Résumé requests + admin ──────────────────────────────────────────────
# The résumé is shared on request. Requests are stored in the database above
# and announced to CONTACT_EMAIL with a signed "review" link.
# Signs review links and the admin session. 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
RESUME_SIGNING_SECRET=
# Password for /admin. At least 16 characters, or the admin area stays off.
ADMIN_PASSWORD=

# ── Analytics ────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── GitHub (download buttons on /tools) ──────────────────────────────────
# OPTIONAL. The site works without it: /tools reads each tool's latest
# release from GitHub once an hour (60 req/h unauthenticated quota).
# Add a fine-grained read-only token to raise the server quota to 5,000/h.
# Server-only — never prefix with NEXT_PUBLIC_.
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
